# Optional: Connect to free Supabase for shared history across all colleagues
# If left empty, it runs with local storage fallback
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional: Token to protect the /api/qr/sync endpoint for your local V17 app
SYNC_SECRET=diaa-sync-secret
